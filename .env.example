# ==============================================================================
# SAKTHI FROZEN FOODS — FRONTEND (NEXT.JS) .ENV TEMPLATE
# Location: sakthi frozen foods (E-commerce)/.env
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. CLIENT-SIDE PUBLIC CONFIGURATION (Accessible in Browser via NEXT_PUBLIC_*)
# ------------------------------------------------------------------------------
NEXT_PUBLIC_SITE_URL=http://localhost:3005
NEXT_PUBLIC_MAIN_SITE_URL=http://localhost:5173

# Optional Direct API URL (leave empty to use Next.js /api proxy routes)
NEXT_PUBLIC_API_URL=

# Razorpay Client Key ID (Safe for browser popup)
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_test_xxxx

# Web Push VAPID Public Key
NEXT_PUBLIC_VAPID_PUBLIC_KEY=xxxx

# ------------------------------------------------------------------------------
# 2. NEXT.JS SERVER-SIDE CONFIGURATION (Never exposed to browser)
# ------------------------------------------------------------------------------
BACKEND_API_URL=http://localhost:5000/api
MONGODB_URI=mongodb+srv://<user>:<password>@cluster0.mongodb.net/properties
JWT_SECRET=your_super_secret_jwt_key

RAZORPAY_KEY_ID=rzp_test_xxxx
RAZORPAY_KEY_SECRET=xxxx
RAZORPAY_WEBHOOK_SECRET=xxxx

VAPID_PUBLIC_KEY=xxxx
VAPID_PRIVATE_KEY=xxxx
VAPID_SUBJECT=mailto:sakthifrozenfoods@gmail.com
